<workout_file>
    <author>Whorl</author>
    <name>Low and Steady</name>
    <description>Steady low-zone-2 riding for fat oxidation. Nothing hard, just time in the aerobic zone.</description>
    <category>Endurance</category>
    <sportType>bike</sportType>
    <tags>
            </tags>
    <workout>
        <Warmup Duration="300" PowerLow="0.65" PowerHigh="0.7"/>
        <SteadyState Duration="600" Power="0.7"/>
        <SteadyState Duration="300" Power="0.75"/>
        <SteadyState Duration="600" Power="0.68"/>
        <SteadyState Duration="300" Power="0.65"/>
    </workout>
</workout_file>
