<workout_file>
    <author>Whorl</author>
    <name>Up and Over</name>
    <description>Intro to intervals: step up through the zones to a sweet-spot peak and back down again. Hold a steady cadence.</description>
    <category>Endurance</category>
    <sportType>bike</sportType>
    <tags>
    </tags>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.6"/>
        <SteadyState Duration="180" Power="0.65"/>
        <SteadyState Duration="180" Power="0.75"/>
        <SteadyState Duration="180" Power="0.9"/>
        <SteadyState Duration="180" Power="0.75"/>
        <SteadyState Duration="180" Power="0.65"/>
        <SteadyState Duration="300" Power="0.6"/>
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.5"/>
    </workout>
</workout_file>
