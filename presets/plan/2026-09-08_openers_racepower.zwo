<workout_file>
    <author>Whorl</author>
    <name>Openers 5x2</name>
    <description>A short pre-race opener: 45 minutes easy with five 2-minute efforts near threshold (98% FTP) and 3 minutes easy between. It should feel easy overall. Finish wanting more.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="openers" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.66" Cadence="90">
            <textevent timeoffset="10" message="45 min easy with five 2-min openers" />
        </Warmup>
        <SteadyState Duration="120" Power="0.978" Cadence="92">
            <textevent timeoffset="0" message="Effort 1 of 5: 2 min at 98% FTP in aero" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.55" Cadence="88">
            <textevent timeoffset="0" message="3 min easy. Drink and refuel" />
        </SteadyState>
