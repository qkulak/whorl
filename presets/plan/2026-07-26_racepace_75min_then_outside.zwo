<workout_file>
    <author>Whorl</author>
    <name>Race Pace 3x12</name>
    <description>Three 12-minute blocks at race pace (82% FTP) with 6 minutes easy between, after a 15-minute warmup. A compact race-specific session that also works as the opening of a longer outdoor ride.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="raceeffort" />
        <tag name="70.3" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.79">
            <textevent timeoffset="10" message="75 min: three 12-min blocks at race pace" />
        </Warmup>
        <SteadyState Duration="720" Power="0.82">
            <textevent timeoffset="0" message="Block 1 of 3: 12 min at 82% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="720" Power="0.82">
            <textevent timeoffset="0" message="Block 2 of 3: 12 min at 82% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="720" Power="0.82">
            <textevent timeoffset="0" message="Block 3 of 3: 12 min at 82% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <Cooldown Duration="720" PowerLow="0.60" PowerHigh="0.55">
            <textevent timeoffset="0" message="Done. 12 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
