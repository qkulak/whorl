<workout_file>
    <author>Whorl</author>
    <name>Race Pace 3x18 + Cadence Drills</name>
    <description>Two and a half hours: three 18-minute blocks at race pace (82% FTP) with 7 minutes easy between, then zone 2 with cadence drills (3 minutes at 98 rpm, then 3 at 63 rpm, four times) and a rolling finish of short seated rises before the cooldown.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="raceeffort" />
        <tag name="endurance" />
        <tag name="70.3" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.79" Cadence="90">
            <textevent timeoffset="10" message="2.5 hours: three 18-min race-pace blocks, then zone 2 with cadence drills" />
        </Warmup>
        <SteadyState Duration="600" Power="0.63" Cadence="90">
            <textevent timeoffset="0" message="10 min of zone 2 at 63% FTP" />
        </SteadyState>
        <SteadyState Duration="1080" Power="0.82" Cadence="88">
            <textevent timeoffset="0" message="Block 1 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="420" Power="0.60" Cadence="90">
            <textevent timeoffset="0" message="7 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1080" Power="0.82" Cadence="88">
            <textevent timeoffset="0" message="Block 2 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="420" Power="0.60" Cadence="90">
            <textevent timeoffset="0" message="7 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1080" Power="0.82" Cadence="88">
            <textevent timeoffset="0" message="Block 3 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="600" Power="0.65" Cadence="88">
            <textevent timeoffset="0" message="10 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="98">
            <textevent timeoffset="0" message="3 min at 98 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="63">
            <textevent timeoffset="0" message="3 min at 63 rpm. Seated, smooth pressure" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="98">
            <textevent timeoffset="0" message="3 min at 98 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="63">
            <textevent timeoffset="0" message="3 min at 63 rpm. Seated, smooth pressure" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="98">
            <textevent timeoffset="0" message="3 min at 98 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="63">
            <textevent timeoffset="0" message="3 min at 63 rpm. Seated, smooth pressure" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="98">
            <textevent timeoffset="0" message="3 min at 98 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.65" Cadence="63">
            <textevent timeoffset="0" message="3 min at 63 rpm. Seated, smooth pressure" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.66" Cadence="92">
            </SteadyState>
        <SteadyState Duration="60" Power="0.72" Cadence="72">
            <textevent timeoffset="0" message="Short rise: 72 rpm, seated and smooth" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.60" Cadence="98">
            <textevent timeoffset="0" message="2 min at 98 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.72" Cadence="72">
            <textevent timeoffset="0" message="Short rise: 72 rpm, seated and smooth" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.62" Cadence="90">
            </SteadyState>
        <SteadyState Duration="60" Power="0.74" Cadence="70">
            <textevent timeoffset="0" message="Short rise: 70 rpm, seated and smooth" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.58" Cadence="100">
            <textevent timeoffset="0" message="2 min at 100 rpm. Light, smooth spin" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.64" Cadence="88">
