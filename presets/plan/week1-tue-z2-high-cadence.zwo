<workout_file>
    <author>Whorl</author>
    <name>Z2 + High-Cadence Efforts</name>
    <description>Zone 2 endurance with four 30-second high-cadence efforts. Keep the legs turning over.</description>
    <sportType>bike</sportType>
    <tags />
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65" />
        <SteadyState Duration="600" Power="0.65" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="570" OnPower="0.70" OffPower="0.65" />
        <SteadyState Duration="600" Power="0.65" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" />
    </workout>
</workout_file>
