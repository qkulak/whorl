<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Training Plan Calc</author>
  <name>Week 1 Tue – Z2 + High-Cadence Efforts</name>
  <description>Zone 2 endurance. Steady spin, 4x30s high-cadence efforts. Keep legs turning over.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <!-- 10 min warmup -->
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65"/>
    <!-- 10 min steady Z2 -->
    <SteadyState Duration="600" Power="0.65"/>
    <!-- 4x30s high-cadence (same Z2 power, spin 100+ rpm), 9:30 Z2 recovery -->
    <IntervalsT Repeat="4" OnDuration="30" OffDuration="570" OnPower="0.70" OffPower="0.65"/>
    <!-- 10 min Z2 -->
    <SteadyState Duration="600" Power="0.65"/>
    <!-- 5 min cooldown -->
    <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40"/>
  </workout>
</workout_file>
