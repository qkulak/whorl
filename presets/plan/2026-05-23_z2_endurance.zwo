<workout_file>
    <author>Whorl</author>
    <name>Z2 Endurance Waves</name>
    <description>Rolling zone 2: after a 10-minute warmup, four waves climb in 5-minute steps from the bottom to the top of zone 2 (56–76% FTP) and drop back down, then a 10-minute cooldown. Steady aerobic work that never sits still.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance" />
        <tag name="Z2" />
    </tags>
    <workout>
