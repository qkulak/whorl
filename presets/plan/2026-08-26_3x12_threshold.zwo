<workout_file>
    <author>Whorl</author>
    <name>Threshold 3x12</name>
    <description>Three 12-minute blocks just above threshold (102% FTP) with 4 minutes easy between, then 12 minutes of zone 2 and a cooldown. Note how each block feels: if all three stay comfortably hard, your FTP may be ready to go up.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="threshold" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="960" PowerLow="0.50" PowerHigh="0.75" Cadence="90">
            <textevent timeoffset="10" message="80 min: three 12-min blocks just above threshold" />
        </Warmup>
        <SteadyState Duration="720" Power="1.016" Cadence="90">
            <textevent timeoffset="0" message="Block 1 of 3: 12 min at 102% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="4 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="720" Power="1.016" Cadence="90">
            <textevent timeoffset="0" message="Block 2 of 3: 12 min at 102% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="4 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="720" Power="1.016" Cadence="90">
            <textevent timeoffset="0" message="Block 3 of 3: 12 min at 102% FTP" />
            <textevent timeoffset="360" message="Halfway. Smooth and steady" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="720" Power="0.72" Cadence="90">
            <textevent timeoffset="0" message="12 min of zone 2 at 72% FTP" />
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.62" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 8 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
