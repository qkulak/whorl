<workout_file>
    <author>Whorl</author>
    <name>Long Ride + 45min Race Pace</name>
    <description>Three hours: about two hours of zone 2 at 75% FTP in four blocks, each followed by a one-minute spin-up at 102 rpm, then 45 minutes continuous at race pace (86% FTP) in aero. It ends without a cooldown, so it also works as a brick: head straight out for a short run.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="endurance" />
        <tag name="racepower" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.73" Cadence="90">
            <textevent timeoffset="10" message="3 hours: two hours of zone 2, then 45 min continuous at race pace" />
        </Warmup>
        <SteadyState Duration="1800" Power="0.75" Cadence="90">
            <textevent timeoffset="0" message="30 min of zone 2 at 75% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.75" Cadence="102">
            <textevent timeoffset="0" message="Spin-up: 60 s at 102 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="1740" Power="0.75" Cadence="90">
            <textevent timeoffset="0" message="29 min of zone 2 at 75% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.75" Cadence="102">
            <textevent timeoffset="0" message="Spin-up: 60 s at 102 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="1740" Power="0.75" Cadence="90">
            <textevent timeoffset="0" message="29 min of zone 2 at 75% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.75" Cadence="102">
            <textevent timeoffset="0" message="Spin-up: 60 s at 102 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="1740" Power="0.75" Cadence="90">
            <textevent timeoffset="0" message="29 min of zone 2 at 75% FTP" />
        </SteadyState>
        <SteadyState Duration="2700" Power="0.86" Cadence="88">
            <textevent timeoffset="0" message="45 min at 86% FTP in aero" />
            <textevent timeoffset="1350" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="2640" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.45" Cadence="80">
            <textevent timeoffset="0" message="Done. Unclip and head out for your run" />
        </SteadyState>
    </workout>
</workout_file>
