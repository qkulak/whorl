<workout_file>
    <author>Whorl</author>
    <name>45min Race Pace Finish</name>
    <description>A short warmup, then 45 minutes continuous at race pace (86% FTP) in aero, with no cooldown. Use it to finish a longer ride with quality, or as a bike-to-run brick: when it ends, head straight out for a short run.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="racepower" />
        <tag name="aero" />
        <tag name="brick" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="300" PowerLow="0.62" PowerHigh="0.74" Cadence="90">
            <textevent timeoffset="10" message="50 min: 45 min continuous at race pace, in aero" />
        </Warmup>
        <SteadyState Duration="2700" Power="0.86" Cadence="88">
            <textevent timeoffset="0" message="45 min at 86% FTP in aero" />
            <textevent timeoffset="1350" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="2640" message="Last minute. When it ends, head straight out for your run" />
        </SteadyState>
    </workout>
</workout_file>
