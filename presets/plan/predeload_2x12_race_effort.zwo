<workout_file>
    <author>Whorl</author>
    <name>Race Pace 2x12</name>
    <description>Two 12-minute blocks at race pace (87% FTP) with 5 minutes easy between, then 26 minutes of easy spinning and a cooldown. If it feels harder than 7/10, sit up and ride the rest easy.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="raceeffort" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.68">
            <textevent timeoffset="10" message="75 min: two 12-min blocks at race pace, then easy" />
        </Warmup>
        <SteadyState Duration="720" Power="0.87">
            <textevent timeoffset="0" message="Block 1 of 2: 12 min at 87% FTP in aero" />
            <textevent timeoffset="360" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.63">
            <textevent timeoffset="0" message="5 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="720" Power="0.87">
            <textevent timeoffset="0" message="Block 2 of 2: 12 min at 87% FTP in aero" />
            <textevent timeoffset="360" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="660" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="1560" Power="0.60">
            <textevent timeoffset="0" message="26 min easy. Drink and refuel" />
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.58" PowerHigh="0.48">
            <textevent timeoffset="0" message="Done. 5 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
