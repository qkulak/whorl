<workout_file>
    <author>Whorl</author>
    <name>Brick Openers 3x4</name>
    <description>Three 4-minute efforts near threshold (98% FTP) with 2 minutes easy between, then 4 minutes at race pace (87% FTP). No cooldown: it's built as a brick, so head straight out for a short run when it ends.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="brick" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.68" Cadence="90">
            <textevent timeoffset="10" message="32 min: three 4-min efforts, then 4 min at race pace. Run kit ready" />
        </Warmup>
        <SteadyState Duration="240" Power="0.978" Cadence="90">
            <textevent timeoffset="0" message="Effort 1 of 3: 4 min at 98% FTP in aero" />
            <textevent timeoffset="180" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="2 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.978" Cadence="90">
            <textevent timeoffset="0" message="Effort 2 of 3: 4 min at 98% FTP in aero" />
            <textevent timeoffset="180" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="120" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="2 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.978" Cadence="90">
            <textevent timeoffset="0" message="Effort 3 of 3: 4 min at 98% FTP in aero" />
            <textevent timeoffset="180" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.87" Cadence="88">
            <textevent timeoffset="0" message="Race pace: 4 min at 87% FTP in aero" />
            <textevent timeoffset="180" message="Last minute. When it ends, head straight out for your run" />
        </SteadyState>
    </workout>
</workout_file>
