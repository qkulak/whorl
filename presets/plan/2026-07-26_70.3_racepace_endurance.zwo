<workout_file>
    <author>Whorl</author>
    <name>Race Pace Endurance 3x18</name>
    <description>Two hours of endurance with three 18-minute blocks at race pace (82% FTP) and 11 minutes of easy zone 2 between them, then 14 minutes steady and a cooldown. Race pace should feel sustainable, not hard: if your breathing gets ragged, ease off.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="raceeffort" />
        <tag name="endurance" />
        <tag name="70.3" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.79">
            <textevent timeoffset="10" message="2 hours: three 18-min blocks at race pace, zone 2 between" />
        </Warmup>
        <SteadyState Duration="300" Power="0.63">
            </SteadyState>
        <SteadyState Duration="1080" Power="0.82">
            <textevent timeoffset="0" message="Block 1 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.65">
            </SteadyState>
        <SteadyState Duration="1080" Power="0.82">
            <textevent timeoffset="0" message="Block 2 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.60">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.65">
            </SteadyState>
        <SteadyState Duration="1080" Power="0.82">
            <textevent timeoffset="0" message="Block 3 of 3: 18 min at 82% FTP" />
            <textevent timeoffset="540" message="Halfway. Smooth and steady" />
            <textevent timeoffset="1020" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.63">
            <textevent timeoffset="0" message="14 min easy. Drink and refuel" />
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.58" PowerHigh="0.45">
            <textevent timeoffset="0" message="Done. 10 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
