<workout_file>
    <author>Whorl</author>
    <name>Aero Threshold 2x20</name>
    <description>Two 20-minute blocks just above threshold (102% FTP) in your aero position, with 6 minutes easy between, then 10 minutes of zone 2. A hard session: hold the power without sitting up.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="threshold" />
        <tag name="aero" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75" Cadence="90">
            <textevent timeoffset="10" message="76 min: two 20-min blocks just above threshold, in aero" />
        </Warmup>
        <SteadyState Duration="1200" Power="1.016" Cadence="90">
            <textevent timeoffset="0" message="Block 1 of 2: 20 min at 102% FTP in aero" />
            <textevent timeoffset="600" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1140" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1200" Power="1.016" Cadence="90">
            <textevent timeoffset="0" message="Block 2 of 2: 20 min at 102% FTP in aero" />
            <textevent timeoffset="600" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1140" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="600" Power="0.72" Cadence="90">
            <textevent timeoffset="0" message="10 min of zone 2 at 72% FTP" />
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.62" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 5 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
