<workout_file>
    <author>Whorl</author>
    <name>FTP Check 4x8</name>
    <description>Four 8-minute blocks at 100% FTP with 4 minutes easy between. Note how hard each block feels: if all four stay comfortably hard, your FTP is probably higher than the one you've set; if you can't finish the third, it's lower.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="threshold" />
        <tag name="ftptest" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="960" PowerLow="0.50" PowerHigh="0.75" Cadence="90">
            <textevent timeoffset="10" message="75 min: four 8-min blocks at FTP. Note how each one feels" />
        </Warmup>
        <SteadyState Duration="480" Power="1.00" Cadence="90">
            <textevent timeoffset="0" message="Block 1 of 4: 8 min at 100% FTP" />
            <textevent timeoffset="240" message="Halfway. Smooth and steady" />
            <textevent timeoffset="420" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="4 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="480" Power="1.00" Cadence="90">
            <textevent timeoffset="0" message="Block 2 of 4: 8 min at 100% FTP" />
            <textevent timeoffset="240" message="Halfway. Smooth and steady" />
            <textevent timeoffset="420" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="4 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="480" Power="1.00" Cadence="90">
            <textevent timeoffset="0" message="Block 3 of 4: 8 min at 100% FTP" />
            <textevent timeoffset="240" message="Halfway. Smooth and steady" />
            <textevent timeoffset="420" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="4 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="480" Power="1.00" Cadence="90">
            <textevent timeoffset="0" message="Block 4 of 4: 8 min at 100% FTP" />
            <textevent timeoffset="240" message="Halfway. Smooth and steady" />
            <textevent timeoffset="420" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.70" Cadence="90">
            </SteadyState>
        <Cooldown Duration="600" PowerLow="0.62" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 10 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
