<workout_file>
    <author>Whorl</author>
    <name>Undulating Aero Z2</name>
    <description>85 minutes of zone 2 in your aero position. Power and cadence change every 4–5 minutes (71–82% FTP, 85–100 rpm) across a 40-minute and a 28-minute block, so there's always something to manage while you hold position.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="aero" />
        <tag name="endurance" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.74" Cadence="90">
            <textevent timeoffset="10" message="85 min of zone 2 in aero. Power and cadence change every 4-5 min" />
        </Warmup>
        <SteadyState Duration="300" Power="0.746" Cadence="90">
            <textevent timeoffset="0" message="75% FTP, 90 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.800" Cadence="88">
            <textevent timeoffset="0" message="80% FTP, 88 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.714" Cadence="100">
            <textevent timeoffset="0" message="71% FTP, 100 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.811" Cadence="85">
            <textevent timeoffset="0" message="81% FTP, 85 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.757" Cadence="92">
            <textevent timeoffset="0" message="76% FTP, 92 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.800" Cadence="95">
            <textevent timeoffset="0" message="80% FTP, 95 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.714" Cadence="100">
            <textevent timeoffset="0" message="71% FTP, 100 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.811" Cadence="85">
            <textevent timeoffset="0" message="81% FTP, 85 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="180" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="3 min easy. Sit up, stretch, drink" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.757" Cadence="90">
            <textevent timeoffset="0" message="76% FTP, 90 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.811" Cadence="85">
            <textevent timeoffset="0" message="81% FTP, 85 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.730" Cadence="100">
            <textevent timeoffset="0" message="73% FTP, 100 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.800" Cadence="92">
            <textevent timeoffset="0" message="80% FTP, 92 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.757" Cadence="95">
            <textevent timeoffset="0" message="76% FTP, 95 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.822" Cadence="85">
            <textevent timeoffset="0" message="82% FTP, 85 rpm. Stay in aero" />
        </SteadyState>
        <SteadyState Duration="240" Power="0.746" Cadence="90">
            <textevent timeoffset="0" message="75% FTP, 90 rpm. Stay in aero" />
        </SteadyState>
        <Cooldown Duration="240" PowerLow="0.60" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 4 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
