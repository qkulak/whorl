<workout_file>
    <author>Whorl</author>
    <name>Aero Race Pace 2x25</name>
    <description>Two 25-minute blocks at race pace (87% FTP) with 8 minutes easy between. The power is moderate on purpose: the goal is holding your aero position for the full 25 minutes, twice, without sitting up.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="racepower" />
        <tag name="aero" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="960" PowerLow="0.50" PowerHigh="0.72" Cadence="90">
            <textevent timeoffset="10" message="85 min: two 25-min blocks at race pace, all in aero" />
        </Warmup>
        <SteadyState Duration="1500" Power="0.87" Cadence="88">
            <textevent timeoffset="0" message="Block 1 of 2: 25 min at 87% FTP in aero" />
            <textevent timeoffset="750" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1440" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="480" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="8 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1500" Power="0.87" Cadence="88">
            <textevent timeoffset="0" message="Block 2 of 2: 25 min at 87% FTP in aero" />
            <textevent timeoffset="750" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1440" message="Last minute. Hold it to the end" />
        </SteadyState>
        <Cooldown Duration="660" PowerLow="0.62" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 11 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
