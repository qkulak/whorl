<workout_file>
    <author>Whorl</author>
    <name>Sweet Spot 3x10 + Z2</name>
    <description>Three 10-minute sweet spot blocks at 92% FTP with 5 minutes easy between, then 10 minutes of zone 2 and a cooldown. Controlled, not urgent: if a block feels harder than 7/10, spin the rest easy.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="sweetspot" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.72" Cadence="90">
            <textevent timeoffset="10" message="75 min: three 10-min sweet spot blocks, then zone 2" />
        </Warmup>
        <SteadyState Duration="600" Power="0.92" Cadence="90">
            <textevent timeoffset="0" message="Block 1 of 3: 10 min at 92% FTP" />
            <textevent timeoffset="300" message="Halfway. Smooth and steady" />
            <textevent timeoffset="540" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.60" Cadence="85">
            <textevent timeoffset="0" message="5 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="600" Power="0.92" Cadence="90">
            <textevent timeoffset="0" message="Block 2 of 3: 10 min at 92% FTP" />
            <textevent timeoffset="300" message="Halfway. Smooth and steady" />
            <textevent timeoffset="540" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.60" Cadence="85">
            <textevent timeoffset="0" message="5 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="600" Power="0.92" Cadence="90">
            <textevent timeoffset="0" message="Block 3 of 3: 10 min at 92% FTP" />
            <textevent timeoffset="300" message="Halfway. Smooth and steady" />
            <textevent timeoffset="540" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="600" Power="0.72" Cadence="90">
            <textevent timeoffset="0" message="10 min of zone 2 at 72% FTP" />
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 10 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
