<workout_file>
    <author>Whorl</author>
    <name>Aero Race Pace 2x25 + Z2</name>
    <description>Two 25-minute blocks at race pace (87% FTP) with 8 minutes easy between, then a 35-minute zone 2 block. Stay in your aero position for all three: 85 minutes in position in total.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="racepower" />
        <tag name="aero" />
        <tag name="703" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.72" Cadence="90">
            <textevent timeoffset="10" message="2 hours: two 25-min race-pace blocks and a 35-min zone 2 block, all in aero" />
        </Warmup>
        <SteadyState Duration="1500" Power="0.87" Cadence="88">
            <textevent timeoffset="0" message="Block 1 of 2: 25 min at 87% FTP in aero" />
            <textevent timeoffset="750" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1440" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="480" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="8 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1500" Power="0.87" Cadence="88">
            <textevent timeoffset="0" message="Block 2 of 2: 25 min at 87% FTP in aero" />
            <textevent timeoffset="750" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1440" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.55" Cadence="85">
            <textevent timeoffset="0" message="5 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="2100" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="35 min of zone 2 at 70% FTP in aero" />
        </SteadyState>
        <Cooldown Duration="420" PowerLow="0.62" PowerHigh="0.45" Cadence="85">
            <textevent timeoffset="0" message="Done. 7 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
