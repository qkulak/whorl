<workout_file>
    <author>Whorl</author>
    <name>Z2 Endurance + Race Pace 2x15</name>
    <description>A long aerobic day: 90 minutes of zone 2 at 70% FTP in six blocks, each followed by a one-minute spin-up at 100 rpm, then two 15-minute blocks at race pace (79% FTP) with 5 minutes easy between, and a 20-minute cooldown. Start fueling early and keep it regular: 60–90 g of carbs an hour.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="endurance" />
        <tag name="racepower" />
        <tag name="70.3" />
    </tags>
    <workout>
        <Warmup Duration="1200" PowerLow="0.51" PowerHigh="0.69" Cadence="90">
            <textevent timeoffset="10" message="2h45: 90 min of zone 2, then two 15-min blocks at race pace" />
        </Warmup>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="840" Power="0.70" Cadence="90">
            <textevent timeoffset="0" message="14 min of zone 2 at 70% FTP" />
        </SteadyState>
        <SteadyState Duration="60" Power="0.70" Cadence="100">
            <textevent timeoffset="0" message="Spin-up: 60 s at 100 rpm, same power" />
        </SteadyState>
        <SteadyState Duration="900" Power="0.79" Cadence="88">
            <textevent timeoffset="0" message="Block 1 of 2: 15 min at 79% FTP" />
            <textevent timeoffset="450" message="Halfway. Smooth and steady" />
            <textevent timeoffset="840" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="300" Power="0.60" Cadence="90">
            <textevent timeoffset="0" message="5 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="900" Power="0.79" Cadence="88">
            <textevent timeoffset="0" message="Block 2 of 2: 15 min at 79% FTP" />
            <textevent timeoffset="450" message="Halfway. Smooth and steady" />
            <textevent timeoffset="840" message="Last minute. Hold it to the end" />
        </SteadyState>
        <Cooldown Duration="1200" PowerLow="0.62" PowerHigh="0.45" Cadence="90">
            <textevent timeoffset="0" message="Done. 20 min cooldown" />
        </Cooldown>
    </workout>
