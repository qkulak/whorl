<workout_file>
    <author>Whorl</author>
    <name>Aero Race Pace 3x20</name>
    <description>Three 20-minute blocks at race pace (89% FTP) in your aero position, 6 minutes easy between. Note your heart rate and effort in each block: it's a good way to calibrate race-day pacing. Fuel 60–90 g of carbs an hour.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="703" />
        <tag name="raceeffort" />
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.52" PowerHigh="0.72">
            <textevent timeoffset="10" message="90 min: three 20-min blocks at race pace, in aero" />
        </Warmup>
        <SteadyState Duration="1200" Power="0.89">
            <textevent timeoffset="0" message="Block 1 of 3: 20 min at 89% FTP in aero" />
            <textevent timeoffset="600" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1140" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.65">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1200" Power="0.89">
            <textevent timeoffset="0" message="Block 2 of 3: 20 min at 89% FTP in aero" />
            <textevent timeoffset="600" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1140" message="Last minute. Hold it to the end" />
        </SteadyState>
        <SteadyState Duration="360" Power="0.65">
            <textevent timeoffset="0" message="6 min easy. Drink and refuel" />
        </SteadyState>
        <SteadyState Duration="1200" Power="0.89">
            <textevent timeoffset="0" message="Block 3 of 3: 20 min at 89% FTP in aero" />
            <textevent timeoffset="600" message="Halfway. Stay down in the bars" />
            <textevent timeoffset="1140" message="Last minute. Hold it to the end" />
        </SteadyState>
        <Cooldown Duration="180" PowerLow="0.60" PowerHigh="0.50">
            <textevent timeoffset="0" message="Done. 3 min cooldown" />
        </Cooldown>
    </workout>
</workout_file>
