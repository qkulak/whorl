<workout_file>
    <author>Whorl</author>
    <name>Z2 Lifts</name>
    <description>An hour of zone 2 at a steady 90 rpm: mostly 66%, with a 2-minute lift to the top of zone 2 at 74% every 10 minutes to break it up. 40 minutes of aerobic work between a 10-minute warmup and a 10-minute cooldown, and it never reaches tempo.</description>
    <category>Endurance</category>
    <sportType>bike</sportType>
    <tags>
        <tag name="endurance"/>
        <tag name="z2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" Cadence="90">
            <textevent timeoffset="10" message="Zone 2 at 90 rpm: steady 66% with a 2-min lift every 10 min"/>
        </Warmup>
        <SteadyState Duration="480" Power="0.66" Cadence="90">
            <textevent timeoffset="0" message="Settle in at 66%"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.74" Cadence="90">
            <textevent timeoffset="0" message="Lift 1 of 4: 2 min at the top of zone 2, same cadence"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.66" Cadence="90">
            <textevent timeoffset="0" message="Back to steady at 66%. Drink"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.74" Cadence="90">
            <textevent timeoffset="0" message="Lift 2 of 4: 2 min at the top of zone 2, same cadence"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.66" Cadence="90">
            <textevent timeoffset="0" message="Back to steady at 66%. Drink"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.74" Cadence="90">
            <textevent timeoffset="0" message="Lift 3 of 4: 2 min at the top of zone 2, same cadence"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.66" Cadence="90">
            <textevent timeoffset="0" message="Back to steady at 66%. Drink"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.74" Cadence="90">
            <textevent timeoffset="0" message="Lift 4 of 4: 2 min at the top of zone 2, same cadence"/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.62" PowerHigh="0.45" Cadence="90">
            <textevent timeoffset="0" message="Done. 10 min cooldown"/>
        </Cooldown>
    </workout>
</workout_file>
