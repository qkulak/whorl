        <SteadyState Duration="240" Power="0.74">
            <textevent timeoffset="0" message="Float 6 of 7: top of Z2, steady breathing, could still talk"/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.6"/>
        <SteadyState Duration="240" Power="0.74">
            <textevent timeoffset="0" message="Float 7 of 7: top of Z2, steady breathing, could still talk"/>
        </SteadyState>
        <SteadyState Duration="240" Power="0.6"/>
        <SteadyState Duration="360" Power="0.66">
            <textevent timeoffset="0" message="Middle of Z2 to finish the main set"/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.62" PowerHigh="0.5"/>
