<workout_file>
    <author>Quinvy</author>
    <name>Z2 Cadence Builder</name>
    <description>75 minutes of steady zone 2 where the power hardly moves but the cadence does. Each round is 8 min cruising at 85-90 rpm, 2 min spinning at 100+ and 2 min grinding at ~70. It's good for pedaling efficiency and keeps the time moving.</description>
    <category>Endurance</category>
    <sportType>bike</sportType>
    <tags>
        <tag name="endurance"/>
        <tag name="z2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" Cadence="85">
            <textevent timeoffset="10" message="Easy start. Five cadence rounds after this"/>
        </Warmup>
        <SteadyState Duration="480" Power="0.68" Cadence="88">
            <textevent timeoffset="0" message="Round 1 of 5: settle at 85-90 rpm"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.68" Cadence="100">
            <textevent timeoffset="0" message="Spin up: 100+ rpm, same watts, smooth hips"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.7" Cadence="70">
            <textevent timeoffset="0" message="Torque: drop to ~70 rpm, seated, push through the whole stroke"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.68" Cadence="88">
            <textevent timeoffset="0" message="Round 2 of 5: settle at 85-90 rpm"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.68" Cadence="100">
            <textevent timeoffset="0" message="Spin up: 100+ rpm, same watts, smooth hips"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.7" Cadence="70">
            <textevent timeoffset="0" message="Torque: drop to ~70 rpm, seated, push through the whole stroke"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.68" Cadence="88">
            <textevent timeoffset="0" message="Round 3 of 5: settle at 85-90 rpm"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.68" Cadence="100">
            <textevent timeoffset="0" message="Spin up: 100+ rpm, same watts, smooth hips"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.7" Cadence="70">
            <textevent timeoffset="0" message="Torque: drop to ~70 rpm, seated, push through the whole stroke"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.68" Cadence="88">
            <textevent timeoffset="0" message="Round 4 of 5: settle at 85-90 rpm"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.68" Cadence="100">
            <textevent timeoffset="0" message="Spin up: 100+ rpm, same watts, smooth hips"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.7" Cadence="70">
            <textevent timeoffset="0" message="Torque: drop to ~70 rpm, seated, push through the whole stroke"/>
        </SteadyState>
        <SteadyState Duration="480" Power="0.68" Cadence="88">
            <textevent timeoffset="0" message="Round 5 of 5: settle at 85-90 rpm"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.68" Cadence="100">
            <textevent timeoffset="0" message="Spin up: 100+ rpm, same watts, smooth hips"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.7" Cadence="70">
            <textevent timeoffset="0" message="Torque: drop to ~70 rpm, seated, push through the whole stroke"/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.62" PowerHigh="0.5" Cadence="85"/>
    </workout>
</workout_file>
