<workout_file>
    <author>Quinvy</author>
    <name>Race Warmup</name>
    <description>Pre-race primer: zone 2, then a minute each at low and high tempo, 50 s at FTP, a 10-second sprint, and an easy spin. Main set as specified; the warmup and cooldown are added.</description>
    <category>Endurance</category>
    <sportType>bike</sportType>
    <tags>
        <tag name="classic"/>
    </tags>
    <workout>
        <SteadyState Duration="720" Power="0.65"/>
        <SteadyState Duration="60" Power="0.78"/>
        <SteadyState Duration="60" Power="0.86"/>
        <SteadyState Duration="50" Power="1"/>
        <SteadyState Duration="10" Power="1.5">
            <textevent timeoffset="0" message="10 second sprint"/>
        </SteadyState>
        <SteadyState Duration="420" Power="0.55"/>
    </workout>
</workout_file>
