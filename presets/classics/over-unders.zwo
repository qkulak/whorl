<workout_file>
    <author>Quinvy</author>
    <name>Over-Unders + Ramp</name>
    <description>Threshold over-unders, then a ramp to finish. Covers every block type, including a free-ride section.</description>
    <sportType>bike</sportType>
    <tags/>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.72"/>
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.92"/>
        <SteadyState Duration="300" Power="0.5"/>
        <Ramp Duration="480" PowerLow="0.7" PowerHigh="1.1"/>
        <FreeRide Duration="300" FlatRoad="1"/>
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.35"/>
    </workout>
</workout_file>
