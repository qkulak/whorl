<workout_file>
    <author>Quinvy</author>
    <name>Sweet Spot 3x10</name>
    <description>Three 10-minute sweet spot blocks at 90% with 5 minutes easy between. Smooth and steady.</description>
    <sportType>bike</sportType>
    <tags/>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="10" message="Easy spin to start. Let the legs wake up."/>
        </Warmup>
        <SteadyState Duration="600" Power="0.9">
            <textevent timeoffset="0" message="Block 1 of 3. Settle in at sweet spot."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.9">
            <textevent timeoffset="0" message="Block 2 of 3."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.9">
            <textevent timeoffset="0" message="Last block. Stay smooth."/>
        </SteadyState>
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.4"/>
    </workout>
</workout_file>
