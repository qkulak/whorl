<workout_file>
    <author>Whorl</author>
    <name>Threshold Over-Unders</name>
    <description>Two 10-minute sets of 2 minutes at 95% with 30-second surges at 115%, with 8 minutes recovery. Main set as specified; the warmup and cooldown are added.</description>
    <category>Threshold</category>
    <sportType>bike</sportType>
    <tags>
        <tag name="classic"/>
    </tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="0.95" OffPower="1.15"/>
        <SteadyState Duration="480" Power="0.5"/>
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="0.95" OffPower="1.15"/>
        <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4"/>
    </workout>
</workout_file>
